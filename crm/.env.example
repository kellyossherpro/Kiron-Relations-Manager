# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://crm:crm@localhost:5432/crm_dev
TEST_DATABASE_URL=postgres://crm:crm@localhost:5432/crm_test
# "dev" shows a simple sign-in picker for local work. Microsoft sign-in replaces it before go-live.
AUTH_MODE=dev
# Secret the scheduler sends to /api/cron/daily (any long random string)
CRON_SECRET=
